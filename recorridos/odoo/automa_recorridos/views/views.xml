<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_recorrido_list" model="ir.ui.view">
        <field name="name">x_automa_recorrido.list</field>
        <field name="model">x_automa_recorrido</field>
        <field name="arch" type="xml">
            <list create="0" multi_edit="1" default_order="x_fecha desc, id desc">
                <field name="x_fecha" readonly="1"/>
                <field name="x_obra_id" string="Obra" decoration-bf="1" options="{'no_create': True}"/>
                <field name="x_obra" string="Escrito por el técnico" optional="show" readonly="1"/>
                <field name="x_plano" optional="show" readonly="1"/>
                <field name="x_order_id" optional="show" options="{'no_create': True}"/>
                <field name="x_partner_id" optional="hide" readonly="1"/>
                <field name="x_tecnico" optional="show" readonly="1"/>
                <field name="x_rojo" string="🔴" sum="Total" decoration-danger="x_rojo &gt; 0" readonly="1"/>
                <field name="x_amarillo" string="🟡" sum="Total" decoration-warning="x_amarillo &gt; 0" readonly="1"/>
                <field name="x_azul" string="🔵" sum="Total" readonly="1"/>
                <field name="x_verde" string="🟢" sum="Total" decoration-success="x_verde &gt; 0" readonly="1"/>
                <field name="x_total" optional="show" readonly="1"/>
                <field name="x_pct_cableado" widget="progressbar" optional="show" readonly="1"/>
                <field name="x_pct_terminado" widget="progressbar" optional="show" readonly="1"/>
                <field name="x_pdf_name" column_invisible="1"/>
                <field name="x_pdf" widget="binary" filename="x_pdf_name" string="PDF"/>
            </list>
        </field>
    </record>
    <record id="view_recorrido_form" model="ir.ui.view">
        <field name="name">x_automa_recorrido.form</field>
        <field name="model">x_automa_recorrido</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <div class="oe_title"><h1><field name="x_name"/></h1></div>
                    <group>
                        <group string="Obra">
                            <field name="x_obra_id" options="{'no_quick_create': True}"/>
                            <field name="x_obra" string="Escrito por el técnico" readonly="1"/>
                            <field name="x_order_id" options="{'no_create': True}"/>
                            <field name="x_partner_id" options="{'no_create': True}"/>
                            <field name="x_fecha"/>
                            <field name="x_tecnico"/>
                        </group>
                        <group string="Avance">
                            <field name="x_rojo"/>
                            <field name="x_amarillo"/>
                            <field name="x_azul"/>
                            <field name="x_verde"/>
                            <field name="x_total"/>
                            <field name="x_pct_cableado" widget="progressbar"/>
                            <field name="x_pct_terminado" widget="progressbar"/>
                        </group>
                    </group>
                    <group>
                        <field name="x_pdf_name" invisible="1"/>
                        <field name="x_pdf" widget="binary" filename="x_pdf_name" string="Descargar PDF"/>
                    </group>
                    <notebook>
                        <page string="PDF" name="pdf">
                            <field name="x_pdf" widget="pdf_viewer" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Técnico" name="tecnico" groups="base.group_no_one">
                            <group>
                                <field name="x_app_uid" readonly="1"/>
                                <field name="x_envios" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_recorrido_graph" model="ir.ui.view">
        <field name="name">x_automa_recorrido.graph</field>
        <field name="model">x_automa_recorrido</field>
        <field name="arch" type="xml">
            <graph type="line" string="Avance por fecha">
                <field name="x_fecha" interval="month"/>
                <field name="x_pct_terminado" type="measure"/>
                <field name="x_pct_cableado" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_recorrido_search" model="ir.ui.view">
        <field name="name">x_automa_recorrido.search</field>
        <field name="model">x_automa_recorrido</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_obra" string="Obra" filter_domain="['|', '|', ('x_obra', 'ilike', self), ('x_order_id.name', 'ilike', self), ('x_partner_id.name', 'ilike', self)]"/>
                <field name="x_obra_id"/>
                <field name="x_order_id"/>
                <field name="x_partner_id"/>
                <field name="x_tecnico"/>
                <filter name="obras_en_curso" string="Obras en curso" domain="[('x_obra_id.x_estado', '=', 'curso')]"/>
                <separator/>
                <filter name="sin_cotizacion" string="Sin cotización ligada" domain="[('x_order_id', '=', False)]"/>
                <filter name="con_pendientes" string="Con pendientes (rojo o amarillo)" domain="['|', ('x_rojo', '&gt;', 0), ('x_amarillo', '&gt;', 0)]"/>
                <separator/>
                <filter name="f_fecha" string="Fecha" date="x_fecha"/>
                <group>
                    <filter name="g_obra" string="Obra" context="{'group_by': 'x_obra_id'}"/>
                    <filter name="g_order" string="Cotización" context="{'group_by': 'x_order_id'}"/>
                    <filter name="g_tecnico" string="Técnico" context="{'group_by': 'x_tecnico'}"/>
                    <filter name="g_mes" string="Mes" context="{'group_by': 'x_fecha:month'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_recorridos" model="ir.actions.act_window">
        <field name="name">Recorridos</field>
        <field name="res_model">x_automa_recorrido</field>
        <field name="view_mode">list,form,graph</field>
        <field name="context">{'search_default_obras_en_curso': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aquí llegan los recorridos de obra</p>
            <p>Los técnicos marcan las salidas en el plano con la app y tocan <b>Enviar → Guardar en Odoo</b>.
               Para conectar la app usa el menú <b>Conectar app de técnicos</b>.</p>
        </field>
    </record>

    <!-- Obras: agrupan los recorridos y llevan el status -->
    <record id="view_obra_list" model="ir.ui.view">
        <field name="name">x_automa_obra.list</field>
        <field name="model">x_automa_obra</field>
        <field name="arch" type="xml">
            <list create="0" multi_edit="1" decoration-muted="x_estado == 'cancelado'">
                <field name="x_name" decoration-bf="1"/>
                <field name="x_partner_id" optional="show"/>
                <field name="x_order_id" optional="show"/>
                <field name="x_ultima_fecha"/>
                <field name="x_recorrido_count" string="Recorridos"/>
                <field name="x_pendientes" decoration-danger="x_pendientes &gt; 0"/>
                <field name="x_pct_cableado" widget="progressbar"/>
                <field name="x_pct_terminado" widget="progressbar"/>
                <field name="x_estado" widget="badge" decoration-info="x_estado == 'curso'" decoration-success="x_estado == 'completado'" decoration-danger="x_estado == 'cancelado'"/>
            </list>
        </field>
    </record>
    <record id="view_obra_kanban" model="ir.ui.view">
        <field name="name">x_automa_obra.kanban</field>
        <field name="model">x_automa_obra</field>
        <field name="arch" type="xml">
            <kanban default_group_by="x_estado" create="0" quick_create="0" group_create="0" group_edit="0" group_delete="0">
                <templates>
                    <t t-name="card">
                        <field name="x_name" class="fw-bold fs-5"/>
                        <field name="x_partner_id" class="small text-muted"/>
                        <div class="small">Terminado <field name="x_pct_terminado" widget="progressbar"/></div>
                        <footer class="pt-1 small">
                            <span><field name="x_recorrido_count"/> recorridos</span>
                            <span class="ms-2 text-danger" invisible="not x_pendientes"><field name="x_pendientes"/> pendientes</span>
                            <field name="x_ultima_fecha" class="ms-auto text-muted"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_obra_form" model="ir.ui.view">
        <field name="name">x_automa_obra.form</field>
        <field name="model">x_automa_obra</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <field name="x_estado" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="x_name" placeholder="Nombre de la obra"/></h1></div>
                    <group>
                        <group>
                            <field name="x_partner_id" options="{'no_create': True}"/>
                            <field name="x_order_id" options="{'no_create': True}"/>
                            <field name="x_ultima_fecha"/>
                        </group>
                        <group string="Último recorrido">
                            <field name="x_pendientes"/>
                            <field name="x_pct_cableado" widget="progressbar"/>
                            <field name="x_pct_terminado" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recorridos" name="recorridos">
                            <field name="x_recorrido_ids" readonly="1">
                                <list default_order="x_fecha desc, id desc">
                                    <field name="x_fecha"/>
                                    <field name="x_plano"/>
                                    <field name="x_tecnico"/>
                                    <field name="x_rojo" string="🔴"/>
                                    <field name="x_amarillo" string="🟡"/>
                                    <field name="x_azul" string="🔵"/>
                                    <field name="x_verde" string="🟢"/>
                                    <field name="x_pct_cableado" widget="progressbar"/>
                                    <field name="x_pct_terminado" widget="progressbar"/>
                                    <field name="x_pdf_name" column_invisible="1"/>
                                    <field name="x_pdf" widget="binary" filename="x_pdf_name" string="PDF"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notas">
                            <field name="x_notas" nolabel="1" placeholder="Notas internas de la obra"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_obra_search" model="ir.ui.view">
        <field name="name">x_automa_obra.search</field>
        <field name="model">x_automa_obra</field>
        <field name="arch" type="xml">
            <search>
                <field name="x_name" string="Obra" filter_domain="['|', '|', ('x_name', 'ilike', self), ('x_partner_id.name', 'ilike', self), ('x_order_id.name', 'ilike', self)]"/>
                <field name="x_partner_id"/>
                <filter name="en_curso" string="En curso" domain="[('x_estado', '=', 'curso')]"/>
                <filter name="completadas" string="Completadas" domain="[('x_estado', '=', 'completado')]"/>
                <filter name="canceladas" string="Canceladas" domain="[('x_estado', '=', 'cancelado')]"/>
                <separator/>
                <filter name="con_pendientes" string="Con pendientes" domain="[('x_pendientes', '&gt;', 0)]"/>
                <group>
                    <filter name="g_estado" string="Status" context="{'group_by': 'x_estado'}"/>
                    <filter name="g_cliente" string="Cliente" context="{'group_by': 'x_partner_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_obras" model="ir.actions.act_window">
        <field name="name">Obras</field>
        <field name="res_model">x_automa_obra</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_en_curso': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aquí aparecen tus obras</p>
            <p>Se crean solas cuando llega el primer recorrido de una obra. Cada obra junta todos sus recorridos y lleva su status: En curso, Completado o Cancelado.</p>
        </field>
    </record>

    <!-- Cotización: botón con los recorridos de esa obra -->
    <record id="view_order_form_recorridos" model="ir.ui.view">
        <field name="name">sale.order.form.recorridos</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Planos" name="automa_planos">
                    <field name="x_plano_ids" context="{'default_x_order_id': id}">
                        <list>
                            <field name="x_name"/>
                            <field name="x_formato"/>
                            <field name="x_archivo_name" column_invisible="1"/>
                            <field name="x_archivo" widget="binary" filename="x_archivo_name" string="Archivo"/>
                            <field name="create_date" string="Subido" widget="date"/>
                            <field name="write_date" string="Actualizado" widget="date" optional="hide"/>
                        </list>
                        <form>
                            <group>
                                <group>
                                    <field name="x_name" required="1" placeholder="Ej. Especiales, Canalizaciones PB…"/>
                                    <field name="x_formato" invisible="not x_formato"/>
                                </group>
                                <group>
                                    <field name="x_archivo_name" invisible="1"/>
                                    <field name="x_archivo" filename="x_archivo_name" required="1" string="Archivo"/>
                                    <field name="create_date" string="Subido" invisible="not id" readonly="1"/>
                                </group>
                            </group>
                            <field name="x_es_pdf" invisible="1"/>
                            <field name="x_vista" widget="pdf_viewer" nolabel="1" invisible="not id or not x_es_pdf"/>
                            <div class="text-muted small" invisible="not id or x_es_pdf">Este archivo no es PDF: se guarda aquí como respaldo y se descarga con la flecha ⬇. No aparece en la app de técnicos.</div>
                            <div class="text-muted small" invisible="id">La vista previa aparece después de guardar.</div>
                        </form>
                    </field>
                    <div class="text-muted small">Los planos de obras vivas (no completadas ni canceladas) aparecen en la app de técnicos.</div>
                </page>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(action_recorridos)d" type="action" class="oe_stat_button" icon="fa-map-marker"
                        context="{'search_default_x_order_id': id, 'default_x_order_id': id}" invisible="not x_recorrido_count">
                    <field name="x_recorrido_count" widget="statinfo" string="Recorridos"/>
                </button>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_root" name="Recorridos" web_icon="automa_recorridos,static/description/icon.png" sequence="6" action="action_obras"/>
    <!-- El ícono va incrustado en el menú para que el navegador no muestre una versión guardada vieja -->
    <record id="menu_root" model="ir.ui.menu">
        <field name="web_icon_data" type="base64" file="automa_recorridos/static/description/icon.png"/>
    </record>
    <menuitem id="menu_obras" name="Obras" parent="menu_root" action="action_obras" sequence="1"/>
    <menuitem id="menu_recorridos" name="Recorridos" parent="menu_root" action="action_recorridos" sequence="2"/>
    <menuitem id="menu_conectar" name="Conectar app de técnicos" parent="menu_root" action="action_conectar_app" sequence="9" groups="base.group_system"/>
</odoo>
