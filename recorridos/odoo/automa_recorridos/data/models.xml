        <field name="compute">rule = self.env.ref('automa_recorridos.automation_webhook_recorrido').sudo()
cat = self.env.ref('automa_recorridos.catalogo_planos').sudo()
for rec in self:
    rec['x_enlace'] = 'https://mauriciomasri.github.io/mauriciomasri/recorridos/app/?odoo=%s&amp;planos=%s:%s' % (rule.url or '', cat.id, cat.access_token or '')</field>
