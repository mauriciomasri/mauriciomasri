<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <!-- Obra: agrupa todos los recorridos de una obra y lleva su status -->
    <record id="model_x_automa_obra" model="ir.model">
        <field name="name">Obra (recorridos)</field>
        <field name="model">x_automa_obra</field>
        <field name="is_mail_thread" eval="True"/>
        <field name="is_mail_activity" eval="True"/>
    </record>
    <record id="field_obra_name" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_obra"/>
        <field name="name">x_name</field>
        <field name="field_description">Obra</field>
        <field name="ttype">char</field>
        <field name="required" eval="True"/>
    </record>
    <record id="field_obra_estado" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_obra"/>
        <field name="name">x_estado</field>
        <field name="field_description">Status</field>
        <field name="ttype">selection</field>
        <field name="selection">[('curso', 'En curso'), ('completado', 'Completado'), ('cancelado', 'Cancelado')]</field>
        <field name="group_expand" eval="False"/>
        <field name="tracking" eval="True"/>
    </record>
    <record id="default_obra_estado" model="ir.default">
        <field name="field_id" ref="field_obra_estado"/>
        <field name="json_value">"curso"</field>
    </record>
    <record id="field_obra_order" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_obra"/>
        <field name="name">x_order_id</field>
        <field name="field_description">Cotización</field>
        <field name="ttype">many2one</field>
        <field name="relation">sale.order</field>
        <field name="on_delete">set null</field>
    </record>
    <record id="field_obra_partner" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_obra"/>
        <field name="name">x_partner_id</field>
        <field name="field_description">Cliente</field>
        <field name="ttype">many2one</field>
        <field name="relation">res.partner</field>
        <field name="on_delete">set null</field>
    </record>
    <record id="field_obra_notas" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_obra"/>
        <field name="name">x_notas</field>
        <field name="field_description">Notas</field>
        <field name="ttype">text</field>
    </record>

    <!-- Recorrido de obra (lo crea la app de técnicos por webhook) -->
    <record id="model_x_automa_recorrido" model="ir.model">
        <field name="name">Recorrido de obra</field>
        <field name="model">x_automa_recorrido</field>
        <field name="is_mail_thread" eval="True"/>
        <field name="is_mail_activity" eval="True"/>
    </record>
    <record id="field_recorrido_name" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_name</field>
        <field name="field_description">Recorrido</field>
        <field name="ttype">char</field>
    </record>
    <record id="field_recorrido_obra" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_obra</field>
        <field name="field_description">Obra (como la escribió el técnico)</field>
        <field name="ttype">char</field>
    </record>
    <record id="field_recorrido_obra_id" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_obra_id</field>
        <field name="field_description">Obra</field>
        <field name="ttype">many2one</field>
        <field name="relation">x_automa_obra</field>
        <field name="on_delete">cascade</field>
        <field name="index">True</field>
    </record>
    <record id="field_recorrido_order" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_order_id</field>
        <field name="field_description">Cotización</field>
        <field name="ttype">many2one</field>
        <field name="relation">sale.order</field>
        <field name="on_delete">set null</field>
        <field name="index">True</field>
    </record>
    <record id="field_recorrido_partner" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_partner_id</field>
        <field name="field_description">Cliente</field>
        <field name="ttype">many2one</field>
        <field name="relation">res.partner</field>
        <field name="on_delete">set null</field>
    </record>
    <record id="field_recorrido_fecha" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_fecha</field>
        <field name="field_description">Fecha</field>
        <field name="ttype">date</field>
    </record>
    <record id="field_recorrido_tecnico" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_tecnico</field>
        <field name="field_description">Técnico</field>
        <field name="ttype">char</field>
    </record>
    <record id="field_recorrido_rojo" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_rojo</field>
        <field name="field_description">Falta tubería</field>
        <field name="ttype">integer</field>
    </record>
    <record id="field_recorrido_amarillo" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_amarillo</field>
        <field name="field_description">Detalle pendiente</field>
        <field name="ttype">integer</field>
    </record>
    <record id="field_recorrido_azul" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_azul</field>
        <field name="field_description">Tubería y cableado OK</field>
        <field name="ttype">integer</field>
    </record>
    <record id="field_recorrido_verde" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_verde</field>
        <field name="field_description">Terminado con equipo</field>
        <field name="ttype">integer</field>
    </record>
    <record id="field_recorrido_total" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_total</field>
        <field name="field_description">Salidas revisadas</field>
        <field name="ttype">integer</field>
    </record>
    <record id="field_recorrido_cableado" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_pct_cableado</field>
        <field name="field_description">% cableado</field>
        <field name="ttype">float</field>
    </record>
    <record id="field_recorrido_terminado" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_pct_terminado</field>
        <field name="field_description">% terminado</field>
        <field name="ttype">float</field>
    </record>
    <record id="field_recorrido_pdf" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_pdf</field>
        <field name="field_description">PDF del recorrido</field>
        <field name="ttype">binary</field>
    </record>
    <record id="field_recorrido_pdf_name" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_pdf_name</field>
        <field name="field_description">Nombre del PDF</field>
        <field name="ttype">char</field>
    </record>
    <record id="field_recorrido_uid" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_app_uid</field>
        <field name="field_description">ID en la app</field>
        <field name="ttype">char</field>
        <field name="index">True</field>
        <field name="copied" eval="False"/>
    </record>
    <record id="field_recorrido_envios" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_envios</field>
        <field name="field_description">Veces recibido</field>
        <field name="ttype">integer</field>
    </record>

    <!-- Obra: recorridos y datos del último recorrido -->
    <record id="field_obra_recorrido_ids" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_obra"/>
        <field name="name">x_recorrido_ids</field>
        <field name="field_description">Recorridos</field>
        <field name="ttype">one2many</field>
        <field name="relation">x_automa_recorrido</field>
        <field name="relation_field">x_obra_id</field>
    </record>
    <record id="field_obra_recorrido_count" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_obra"/>
        <field name="name">x_recorrido_count</field>
        <field name="field_description">Recorridos</field>
        <field name="ttype">integer</field>
        <field name="store" eval="True"/>
        <field name="readonly" eval="True"/>
        <field name="depends">x_recorrido_ids</field>
        <field name="compute">for obra in self:
    obra['x_recorrido_count'] = len(obra.x_recorrido_ids)</field>
    </record>
    <record id="field_obra_ultima_fecha" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_obra"/>
        <field name="name">x_ultima_fecha</field>
        <field name="field_description">Último recorrido</field>
        <field name="ttype">date</field>
        <field name="store" eval="True"/>
        <field name="readonly" eval="True"/>
        <field name="depends">x_recorrido_ids.x_fecha</field>
        <field name="compute">for obra in self:
    ult = obra.x_recorrido_ids.sorted('x_fecha')[-1:]
    obra['x_ultima_fecha'] = ult.x_fecha or False</field>
    </record>
    <record id="field_obra_pendientes" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_obra"/>
        <field name="name">x_pendientes</field>
        <field name="field_description">Pendientes (rojo + amarillo)</field>
        <field name="ttype">integer</field>
        <field name="store" eval="True"/>
        <field name="readonly" eval="True"/>
        <field name="depends">x_recorrido_ids.x_fecha,x_recorrido_ids.x_rojo,x_recorrido_ids.x_amarillo</field>
        <field name="compute">for obra in self:
    ult = obra.x_recorrido_ids.sorted('x_fecha')[-1:]
    obra['x_pendientes'] = (ult.x_rojo or 0) + (ult.x_amarillo or 0)</field>
    </record>
    <record id="field_obra_pct_cableado" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_obra"/>
        <field name="name">x_pct_cableado</field>
        <field name="field_description">% cableado</field>
        <field name="ttype">float</field>
        <field name="store" eval="True"/>
        <field name="readonly" eval="True"/>
        <field name="depends">x_recorrido_ids.x_fecha,x_recorrido_ids.x_pct_cableado</field>
        <field name="compute">for obra in self:
    ult = obra.x_recorrido_ids.sorted('x_fecha')[-1:]
    obra['x_pct_cableado'] = ult.x_pct_cableado or 0.0</field>
    </record>
    <record id="field_obra_pct_terminado" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_obra"/>
        <field name="name">x_pct_terminado</field>
        <field name="field_description">% terminado</field>
        <field name="ttype">float</field>
        <field name="store" eval="True"/>
        <field name="readonly" eval="True"/>
        <field name="depends">x_recorrido_ids.x_fecha,x_recorrido_ids.x_pct_terminado</field>
        <field name="compute">for obra in self:
    ult = obra.x_recorrido_ids.sorted('x_fecha')[-1:]
    obra['x_pct_terminado'] = ult.x_pct_terminado or 0.0</field>
    </record>
    <record id="model_x_automa_obra" model="ir.model">
        <field name="order">x_ultima_fecha desc, id desc</field>
    </record>

    <!-- Orden de la lista (después de crear el campo de fecha) -->
    <record id="model_x_automa_recorrido" model="ir.model">
        <field name="order">x_fecha desc, id desc</field>
    </record>

    <!-- En la cotización: lista de recorridos y contador -->
    <record id="field_order_recorrido_ids" model="ir.model.fields">
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="name">x_recorrido_ids</field>
        <field name="field_description">Recorridos</field>
        <field name="ttype">one2many</field>
        <field name="relation">x_automa_recorrido</field>
        <field name="relation_field">x_order_id</field>
    </record>
    <record id="field_order_recorrido_count" model="ir.model.fields">
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="name">x_recorrido_count</field>
        <field name="field_description">Número de recorridos</field>
        <field name="ttype">integer</field>
        <field name="store" eval="False"/>
        <field name="depends">x_recorrido_ids</field>
        <field name="compute">for rec in self:
    rec['x_recorrido_count'] = len(rec.x_recorrido_ids)</field>
    </record>

    <!-- Plano del proyecto en la orden de venta (lo descargan los técnicos desde la app) -->
    <record id="field_order_plano" model="ir.model.fields">
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="name">x_plano</field>
        <field name="field_description">Plano del proyecto</field>
        <field name="ttype">binary</field>
    </record>
    <record id="field_order_plano_name" model="ir.model.fields">
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="name">x_plano_name</field>
        <field name="field_description">Nombre del plano</field>
        <field name="ttype">char</field>
    </record>

    <!-- Varios planos por orden de venta: canalizaciones, especiales, trayectorias… -->
    <record id="model_x_recorrido_plano" model="ir.model">
        <field name="name">Plano de obra</field>
        <field name="model">x_recorrido_plano</field>
    </record>
    <record id="field_plano_name" model="ir.model.fields">
        <field name="model_id" ref="model_x_recorrido_plano"/>
        <field name="name">x_name</field>
        <field name="field_description">Descripción</field>
        <field name="ttype">char</field>
    </record>
    <record id="field_plano_tipo" model="ir.model.fields">
        <field name="model_id" ref="model_x_recorrido_plano"/>
        <field name="name">x_tipo</field>
        <field name="field_description">Tipo (antiguo)</field>
        <field name="ttype">selection</field>
        <field name="selection">[('canalizaciones', 'Canalizaciones'), ('iluminacion', 'Iluminación'), ('especiales', 'Especiales'), ('trayectorias', 'Trayectorias'), ('otro', 'Personalizado')]</field>
    </record>
    <record id="field_plano_tipo_texto" model="ir.model.fields">
        <field name="model_id" ref="model_x_recorrido_plano"/>
        <field name="name">x_tipo_texto</field>
        <field name="field_description">Tipo personalizado</field>
        <field name="ttype">char</field>
    </record>
    <!-- Tipo de plano libre: se escribe en el campo y se crea si no existe -->
    <record id="model_x_recorrido_plano_tipo" model="ir.model">
        <field name="name">Tipo de plano</field>
        <field name="model">x_recorrido_plano_tipo</field>
    </record>
    <record id="field_plano_tipo_name" model="ir.model.fields">
        <field name="model_id" ref="model_x_recorrido_plano_tipo"/>
        <field name="name">x_name</field>
        <field name="field_description">Tipo</field>
        <field name="ttype">char</field>
        <field name="required" eval="True"/>
    </record>
    <record id="access_x_recorrido_plano_tipo_user" model="ir.model.access">
        <field name="name">x_recorrido_plano_tipo usuarios</field>
        <field name="model_id" ref="model_x_recorrido_plano_tipo"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="field_plano_tipo_id" model="ir.model.fields">
        <field name="model_id" ref="model_x_recorrido_plano"/>
        <field name="name">x_tipo_id</field>
        <field name="field_description">Tipo de plano</field>
        <field name="ttype">many2one</field>
        <field name="relation">x_recorrido_plano_tipo</field>
        <field name="on_delete">restrict</field>
    </record>
    <record id="field_plano_archivo" model="ir.model.fields">
        <field name="model_id" ref="model_x_recorrido_plano"/>
        <field name="name">x_archivo</field>
        <field name="field_description">PDF</field>
        <field name="ttype">binary</field>
    </record>
    <record id="field_plano_vista" model="ir.model.fields">
        <field name="model_id" ref="model_x_recorrido_plano"/>
        <field name="name">x_vista</field>
        <field name="field_description">Vista previa</field>
        <field name="ttype">binary</field>
        <field name="related">x_archivo</field>
        <field name="readonly" eval="True"/>
        <field name="store" eval="False"/>
    </record>
    <record id="field_plano_es_pdf" model="ir.model.fields">
        <field name="model_id" ref="model_x_recorrido_plano"/>
        <field name="name">x_es_pdf</field>
        <field name="field_description">Es PDF</field>
        <field name="ttype">boolean</field>
        <field name="store" eval="False"/>
        <field name="depends">x_archivo_name</field>
        <field name="compute">for rec in self:
    rec['x_es_pdf'] = (rec.x_archivo_name or '').lower().endswith('.pdf')</field>
    </record>
    <!-- Tipo = formato del archivo (PDF, DWG…), lo pone Odoo solo -->
    <record id="field_plano_formato" model="ir.model.fields">
        <field name="model_id" ref="model_x_recorrido_plano"/>
        <field name="name">x_formato</field>
        <field name="field_description">Tipo</field>
        <field name="ttype">char</field>
        <field name="store" eval="True"/>
        <field name="depends">x_archivo_name</field>
        <field name="compute">for rec in self:
    nombre = rec.x_archivo_name or ''
    rec['x_formato'] = nombre.rsplit('.', 1)[1].upper() if '.' in nombre else ''</field>
    </record>
    <record id="field_plano_archivo_name" model="ir.model.fields">
        <field name="model_id" ref="model_x_recorrido_plano"/>
        <field name="name">x_archivo_name</field>
        <field name="field_description">Archivo</field>
        <field name="ttype">char</field>
    </record>
    <record id="field_plano_order" model="ir.model.fields">
        <field name="model_id" ref="model_x_recorrido_plano"/>
        <field name="name">x_order_id</field>
        <field name="field_description">Orden de venta</field>
        <field name="ttype">many2one</field>
        <field name="relation">sale.order</field>
        <field name="on_delete">cascade</field>
        <field name="index">True</field>
    </record>
    <record id="field_order_plano_ids" model="ir.model.fields">
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="name">x_plano_ids</field>
        <field name="field_description">Planos</field>
        <field name="ttype">one2many</field>
        <field name="relation">x_recorrido_plano</field>
        <field name="relation_field">x_order_id</field>
    </record>
    <record id="field_order_plano_count" model="ir.model.fields">
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="name">x_plano_count</field>
        <field name="field_description">Número de planos</field>
        <field name="ttype">integer</field>
        <field name="store" eval="False"/>
        <field name="depends">x_plano_ids</field>
        <field name="compute">for rec in self:
    rec['x_plano_count'] = len(rec.x_plano_ids)</field>
    </record>
    <record id="field_recorrido_plano" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_plano</field>
        <field name="field_description">Plano</field>
        <field name="ttype">char</field>
    </record>
    <!-- Plano de la orden de venta sobre el que se hizo el recorrido (para que cualquier iPad parta del último) -->
    <record id="field_recorrido_plano_id" model="ir.model.fields">
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="name">x_plano_id</field>
        <field name="field_description">Plano de la orden</field>
        <field name="ttype">many2one</field>
        <field name="relation">x_recorrido_plano</field>
        <field name="on_delete">set null</field>
        <field name="index">True</field>
    </record>
    <record id="access_x_recorrido_plano_user" model="ir.model.access">
        <field name="name">x_recorrido_plano usuarios</field>
        <field name="model_id" ref="model_x_recorrido_plano"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Permisos: usuarios internos -->
    <record id="access_x_automa_obra_user" model="ir.model.access">
        <field name="name">x_automa_obra usuarios</field>
        <field name="model_id" ref="model_x_automa_obra"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="access_x_automa_recorrido_user" model="ir.model.access">
        <field name="name">x_automa_recorrido usuarios</field>
        <field name="model_id" ref="model_x_automa_recorrido"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
